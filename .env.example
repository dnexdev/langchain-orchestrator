# Copy to .env and fill in. .env is git-ignored. Real environment variables
# take priority over this file.

# Provider key. Only the provider(s) used by the models below are required.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Models in LangChain "provider:model" form.
# A small, fast model is ideal for the router. The answer model can be bigger.
ROUTER_MODEL=openai:gpt-5.6-luna
ANSWER_MODEL=openai:gpt-5.6-luna
# Optional, only for models that accept it (e.g. none, minimal, low).
# REASONING_EFFORT=low

# Start the general answer while the router decides (see README).
SPECULATIVE_ROUTING=true

LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
STREAM_IDLE_TIMEOUT_S=30

# Optional. When set, callers must send it in the X-API-Key header.
# SERVICE_API_KEY=

# Optional LangSmith tracing of every chain run.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

LOG_LEVEL=INFO
